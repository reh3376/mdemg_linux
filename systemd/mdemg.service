[Unit]
Description=MDEMG - Multi-Dimensional Emergent Memory Graph
Documentation=https://github.com/reh3376/mdemg_linux
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=%i
Environment=MDEMG_CONFIG_DIR=%h/.mdemg
ExecStartPre=/usr/local/bin/mdemg db start
ExecStart=/usr/local/bin/mdemg serve --auto-migrate
ExecStop=/usr/local/bin/mdemg stop
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mdemg

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.mdemg
PrivateTmp=true

[Install]
WantedBy=multi-user.target
